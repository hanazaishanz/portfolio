{
  "name": "raff-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Naufal Rafi's responsive static portfolio",
  "scripts": {
    "build": "tailwindcss -i ./style/input.css -o ./style/syling.css --minify && node scripts/version-css.cjs",
    "dev": "tailwindcss -i ./style/input.css -o ./style/syling.css --watch",
    "check": "node --check script/script.js && node --check preview/hero.js",
    "test": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/cli": "4.1.18",
    "tailwindcss": "4.1.18"
  }
}
